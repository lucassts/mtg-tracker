# Copie para `.env` e preencha. Sem estas variáveis o app funciona normalmente
# e a telemetria anônima vira no-op — nenhuma requisição é feita.
#
# Atenção: `EXPO_PUBLIC_*` é embutido no bundle JavaScript. Qualquer pessoa que
# abra o APK consegue lê-las. Por isso aqui só entra a chave `anon` do Supabase,
# cujo alcance é definido pelas policies de RLS em supabase/schema.sql —
# NUNCA coloque a service_role aqui.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
